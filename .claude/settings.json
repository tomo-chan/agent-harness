{
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyRead": [
        "~/.git-credentials",
        "~/.ssh"
      ]
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${AGENT_HARNESS_TRUSTED_ROOT:?AGENT_HARNESS_TRUSTED_ROOT is required}/reference/launcher/trusted_hook.py\" claude"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${AGENT_HARNESS_TRUSTED_ROOT:?AGENT_HARNESS_TRUSTED_ROOT is required}/reference/launcher/trusted_hook.py\" claude"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${AGENT_HARNESS_TRUSTED_ROOT:?AGENT_HARNESS_TRUSTED_ROOT is required}/reference/launcher/trusted_hook.py\" claude"
          }
        ]
      }
    ]
  }
}
