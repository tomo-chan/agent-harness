{
  "permissions": {
    "deny": [
      "Read(.env*)",
      "Read(~/.config/gh/**)",
      "Read(~/.git-credentials)",
      "Read(~/.ssh/**)",
      "Write(.env*)",
      "Write(.git/**)",
      "Exec(sudo)",
      "Exec(git push --force)",
      "Exec(git credential)",
      "Exec(gh auth)",
      "Exec(gh api)",
      "Exec(gh extension)"
    ],
    "ask": [
      "Exec(gh pr merge)",
      "Exec(terraform)",
      "Exec(kubectl)",
      "Exec(gcloud)",
      "Exec(aws)",
      "Exec(az)"
    ],
    "allow": [
      "Read(**)",
      "Write(**)",
      "Exec(git)",
      "Exec(gh pr create)",
      "Exec(gh pr view)",
      "Exec(gh pr status)",
      "Exec(gh pr checks)",
      "Exec(pytest)",
      "Exec(python -m pytest)",
      "Exec(ruff)",
      "Exec(mypy)"
    ]
  }
}
