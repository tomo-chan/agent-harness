{
  "default": "ask",
  "deny": [
    {
      "id": "outside-workspace-write",
      "tool_regex": "(?i)^(Write|Edit|write|edit|multi_edit)$",
      "path_scope": "outside_workspace",
      "reason": "File writes must stay inside the active workspace."
    },
    {
      "id": "sensitive-file-write",
      "tool_regex": "(?i)^(Write|Edit|write|edit|multi_edit)$",
      "path_regex": "(^|/)(\\.env($|\\.)|\\.git/|credentials?($|\\.)|secrets?($|\\.))",
      "reason": "Sensitive credential or Git-internal paths are protected."
    },
    {
      "id": "destructive-shell",
      "tool_regex": "(?i)^(Bash|exec|shell)$",
      "command_regex": "(?i)(^|[;&|]\\s*)(sudo\\b|su\\s+-|mkfs\\b|shutdown\\b|reboot\\b|terraform\\s+destroy\\b|kubectl\\s+delete\\b|rm\\s+-[^\\n]*r[^\\n]*f\\s+/(?:\\s|$)|dd\\s+[^\\n]*of=/dev/)" ,
      "reason": "Destructive or privileged shell operation is prohibited."
    },
    {
      "id": "git-force-push",
      "command_regex": "(?i)\\bgit\\s+push\\b[^\\n]*(--force(?:-with-lease)?|-f)(?:\\s|$)",
      "reason": "Force push is prohibited for autonomous sessions."
    },
    {
      "id": "protected-branch-push",
      "command_regex": "(?i)\\bgit\\s+push\\b[^\\n]*(?:\\s|:)(main|master)(?:\\s|$)",
      "reason": "Direct push to a protected default branch is prohibited."
    }
  ],
  "ask": [
    {
      "id": "harness-config-change",
      "tool_regex": "(?i)^(Write|Edit|write|edit|multi_edit)$",
      "path_regex": "(^|/)(\\.claude/|\\.codex/|\\.devin/|\\.github/workflows/|AGENTS\\.md$)",
      "reason": "Changing agent, policy, or CI control files requires explicit approval."
    },
    {
      "id": "scm-merge-release",
      "command_regex": "(?i)\\b(gh\\s+pr\\s+merge|git\\s+tag|gh\\s+release)\\b",
      "reason": "Merge, tag, and release operations require explicit approval."
    },
    {
      "id": "cloud-mutation",
      "command_regex": "(?i)\\b(aws|gcloud|az|terraform|kubectl)\\b",
      "reason": "Cloud and cluster commands require explicit approval unless separately scoped."
    }
  ],
  "allow": [
    {
      "id": "workspace-file-read",
      "tool_regex": "(?i)^(Read|Glob|Grep|read|glob|grep)$",
      "reason": "Repository discovery is allowed."
    },
    {
      "id": "workspace-file-write",
      "tool_regex": "(?i)^(Write|Edit|write|edit|multi_edit)$",
      "path_scope": "workspace",
      "reason": "Ordinary source edits inside the workspace are allowed."
    },
    {
      "id": "codex-apply-patch",
      "tool_regex": "(?i)^apply_patch$",
      "reason": "Patch application is allowed; the sandbox remains the filesystem boundary."
    },
    {
      "id": "read-only-shell",
      "tool_regex": "(?i)^(Bash|exec|shell)$",
      "command_regex": "(?i)^\\s*(pwd|ls|find|rg|grep|cat|head|tail|wc|stat|file|tree)(?:\\s|$)",
      "reason": "Common read-only repository inspection is allowed."
    },
    {
      "id": "read-only-git",
      "command_regex": "(?i)^\\s*git\\s+(status|diff|log|show|branch|rev-parse|worktree\\s+list)(?:\\s|$)",
      "reason": "Read-only Git inspection is allowed."
    },
    {
      "id": "feature-git-mutation",
      "command_regex": "(?i)^\\s*git\\s+(add|commit|checkout|switch|restore|worktree\\s+add|push)(?:\\s|$)",
      "reason": "Routine feature-branch Git operations are allowed; deny rules protect force/default-branch pushes."
    },
    {
      "id": "verification",
      "command_regex": "(?i)^\\s*(python\\s+-m\\s+pytest|pytest|ruff|mypy|npm\\s+(test|run\\s+(test|lint|typecheck))|pnpm\\s+(test|lint)|yarn\\s+(test|lint)|go\\s+test|cargo\\s+test)(?:\\s|$)",
      "reason": "Verification commands are allowed."
    },
    {
      "id": "pr-publish",
      "command_regex": "(?i)^\\s*gh\\s+pr\\s+(create|view|status|checks)(?:\\s|$)",
      "reason": "PR creation and inspection are allowed."
    }
  ]
}
