{
  "default": "ask",
  "deny": [
    {
      "id": "deny-destructive-shell",
      "tool_regex": "^(exec|Bash)$",
      "command_regex": "(^|[;&| ]+)(sudo\\b|rm\\s+-[^\\n]*r[^\\n]*f|terraform\\s+destroy\\b|kubectl\\s+delete\\b)",
      "reason": "destructive or privileged command is prohibited"
    },
    {
      "id": "deny-force-push",
      "tool_regex": "^(exec|Bash)$",
      "command_regex": "git[ \\t]+push\\b[^\\n]*(?:--force(?:-with-lease|-if-includes)?|-f)(?:[= \\t]|$)",
      "reason": "force push is prohibited"
    },
    {
      "id": "deny-default-branch-push",
      "tool_regex": "^(exec|Bash)$",
      "command_regex": "git\\s+push\\b[^\\n]*(main|master)(:|\\s|$)",
      "reason": "direct push to a protected default branch is prohibited"
    }
  ],
  "ask": [
    {
      "id": "approve-merge",
      "tool_regex": "^(exec|Bash)$",
      "command_regex": "(^|\\s)gh\\s+pr\\s+merge\\b",
      "reason": "merging crosses the autonomous coding boundary"
    },
    {
      "id": "approve-cloud-mutation",
      "tool_regex": "^(exec|Bash)$",
      "command_regex": "(^|\\s)(aws|gcloud|az|terraform|kubectl)\\b",
      "reason": "cloud or cluster mutation requires contextual authorization"
    }
  ],
  "allow": [
    {
      "id": "allow-git-read",
      "tool_regex": "^(exec|Bash)$",
      "command_regex": "^git[ \\t]+(?:(?:status|diff|log|show|branch|rev-parse)(?:[ \\t]+[A-Za-z0-9._/@:=+~,^-]+)*|worktree[ \\t]+list(?:[ \\t]+[A-Za-z0-9._/@:=+~,^-]+)*)[ \\t]*$",
      "reason": "read-only Git inspection"
    },
    {
      "id": "allow-tests",
      "tool_regex": "^(exec|Bash)$",
      "command_regex": "^(?:(?:pytest|ruff|mypy)(?:[ \\t]+[A-Za-z0-9._/@:=+~,^-]+)*|npm[ \\t]+test(?:[ \\t]+[A-Za-z0-9._/@:=+~,^-]+)*|go[ \\t]+test(?:[ \\t]+[A-Za-z0-9._/@:=+~,^-]+)*)[ \\t]*$",
      "reason": "verification command"
    },
    {
      "id": "allow-canonical-push-candidate",
      "tool_regex": "^(exec|Bash)$",
      "command_regex": "^git[ \\t]+push[ \\t]+(?:--set-upstream[ \\t]+)?origin[ \\t]+HEAD:refs/heads/[A-Za-z0-9][A-Za-z0-9._/-]*[ \\t]*$",
      "reason": "canonical feature-branch push candidate requires Publication Guard validation"
    },
    {
      "id": "allow-canonical-pr-create-candidate",
      "tool_regex": "^(exec|Bash)$",
      "command_regex": "^gh[ \\t]+pr[ \\t]+create[ \\t]+--fill[ \\t]*$",
      "reason": "canonical PR creation candidate requires Publication Guard validation"
    },
    {
      "id": "allow-pr-read",
      "tool_regex": "^(exec|Bash)$",
      "command_regex": "^gh[ \\t]+pr[ \\t]+(?:view|status)(?:[ \\t]+[A-Za-z0-9._/@:=+~,^-]+)*[ \\t]*$",
      "reason": "read-only pull-request inspection"
    }
  ]
}
