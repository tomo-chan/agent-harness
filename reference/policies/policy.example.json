{
  "default": "ask",
  "deny": [
    {
      "id": "outside-workspace-write",
      "tool_regex": "(?i)^(Write|Edit|write|edit|multi_edit)$",
      "path_scope": "outside_workspace",
      "reason": "File writes must stay inside the active workspace."
    },
    {
      "id": "sensitive-file-read",
      "tool_regex": "(?i)^(Read|read)$",
      "path_regex": "(^|/)(\\.env($|\\.)|\\.git-credentials$|\\.ssh/|credentials?($|\\.)|secrets?($|\\.)|\\.config/gh/hosts\\.yml$)",
      "reason": "Known credential-bearing files are not agent-readable."
    },
    {
      "id": "sensitive-file-write",
      "tool_regex": "(?i)^(Write|Edit|write|edit|multi_edit)$",
      "path_regex": "(^|/)(\\.env($|\\.)|\\.git/|\\.git-credentials$|\\.ssh/|credentials?($|\\.)|secrets?($|\\.)|\\.config/gh/hosts\\.yml$)",
      "reason": "Sensitive credential or Git-internal paths are protected."
    },
    {
      "id": "credential-extraction-shell",
      "command_regex": "(?i)(gh\\s+auth\\s+token|git\\s+credential(?:-[a-z0-9_-]+)?\\b|(?:cat|head|tail|sed|awk)\\s+[^\\n]*(?:\\.git-credentials|\\.config/gh/hosts\\.yml|/\\.ssh/))",
      "reason": "Direct credential extraction is prohibited; credential compromise is contained separately by SCM/IAM policy."
    },
    {
      "id": "destructive-shell",
      "tool_regex": "(?i)^(Bash|exec|shell)$",
      "command_regex": "(?i)(^|[;&|]\\s*)(sudo\\b|su\\s+-|mkfs\\b|shutdown\\b|reboot\\b|terraform\\s+destroy\\b|kubectl\\s+delete\\b|rm\\s+-[^\\n]*r[^\\n]*f\\s+/(?:\\s|$)|dd\\s+[^\\n]*of=/dev/)",
      "reason": "Destructive or privileged shell operation is prohibited."
    },
    {
      "id": "git-force-push",
      "command_regex": "(?i)\\bgit\\s+push\\b[^\\n]*(--force(?:-with-lease)?|-f)(?:\\s|$)",
      "reason": "Force push is prohibited for autonomous sessions."
    }
  ],
  "ask": [
    {
      "id": "harness-config-change",
      "tool_regex": "(?i)^(Write|Edit|write|edit|multi_edit)$",
      "path_regex": "(^|/)(\\.agent-harness/|\\.claude/|\\.codex/|\\.devin/|\\.github/workflows/|reference/harness/|reference/hooks/|reference/posture/|reference/policies/|reference/application_gate/|AGENTS\\.md$)",
      "reason": "Changing agent, posture, policy, application architecture gate, or CI control files requires explicit approval."
    },
    {
      "id": "scm-merge-release",
      "command_regex": "(?i)\\b(gh\\s+pr\\s+merge|git\\s+tag|gh\\s+release)\\b",
      "reason": "Merge, tag, and release operations require explicit approval."
    },
    {
      "id": "cloud-mutation",
      "command_regex": "(?i)\\b(aws|gcloud|az|terraform|kubectl)\\b",
      "reason": "Cloud and cluster commands require explicit approval unless separately scoped."
    }
  ],
  "allow": [
    {
      "id": "workspace-file-read",
      "tool_regex": "(?i)^(Read|Glob|Grep|read|glob|grep)$",
      "reason": "Repository discovery is allowed."
    },
    {
      "id": "workspace-file-write",
      "tool_regex": "(?i)^(Write|Edit|write|edit|multi_edit)$",
      "path_scope": "workspace",
      "reason": "Ordinary source edits inside the workspace are allowed."
    },
    {
      "id": "codex-apply-patch",
      "tool_regex": "(?i)^apply_patch$",
      "reason": "Patch application is allowed; the sandbox remains the filesystem boundary."
    },
    {
      "id": "read-only-shell",
      "tool_regex": "(?i)^(Bash|exec|shell)$",
      "command_regex": "(?i)^\\s*(pwd|ls|find|rg|grep|cat|head|tail|wc|stat|file|tree)(?:\\s+[^;&|<>\\n]*)?\\s*$",
      "reason": "A single common read-only repository inspection command is allowed."
    },
    {
      "id": "read-only-git",
      "command_regex": "(?i)^\\s*git\\s+(status|diff|log|show|branch|rev-parse|worktree\\s+list)(?:\\s+[^;&|<>\\n]*)?\\s*$",
      "reason": "A single read-only Git inspection command is allowed."
    },
    {
      "id": "feature-git-mutation",
      "command_regex": "(?i)^\\s*git\\s+(add|commit|checkout|switch|restore|worktree\\s+add)(?:\\s+[^;&|<>\\n]*)?\\s*$",
      "reason": "Routine local feature-branch Git operations are allowed."
    },
    {
      "id": "canonical-git-push",
      "command_regex": "(?i)^\\s*git\\s+push(?:\\s+--set-upstream\\s+origin\\s+HEAD)?\\s*$",
      "reason": "Only the canonical push forms are autonomous; semantic validation confirms repository, branch and upstream."
    },
    {
      "id": "verification",
      "command_regex": "(?i)^\\s*(python\\s+-m\\s+pytest|pytest|ruff|mypy|npm\\s+(test|run\\s+(test|lint|typecheck))|pnpm\\s+(test|lint)|yarn\\s+(test|lint)|go\\s+test|cargo\\s+test)(?:\\s+[^;&|<>\\n]*)?\\s*$",
      "reason": "A single verification command is allowed."
    },
    {
      "id": "pr-publish",
      "command_regex": "(?i)^\\s*gh\\s+pr\\s+(create|view|status|checks)(?:\\s+[^;&|<>\\n]*)?\\s*$",
      "reason": "PR creation and inspection are allowed when repository posture and semantic validation permit them."
    }
  ]
}
