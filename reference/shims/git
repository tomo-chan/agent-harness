#!/usr/bin/env python3
from __future__ import annotations

import json
import os
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "scm_broker"))
from client import request

REAL_GIT = os.environ.get("AGENT_HARNESS_REAL_GIT", "/usr/bin/git")
REMOTE_OPS = {"push", "fetch", "pull", "clone"}
DENY = {"credential", "daemon", "http-backend", "shell"}


def main() -> int:
    args = sys.argv[1:]
    if not args:
        return subprocess.call([REAL_GIT])
    op = next((arg for arg in args if not arg.startswith("-")), "")
    if op in DENY:
        print(f"agent-harness: git {op} is not exposed to the agent", file=sys.stderr)
        return 126
    if op in REMOTE_OPS:
        result = request({"kind": "git", "args": args[args.index(op):], "cwd": os.getcwd()})
        sys.stdout.write(result.get("stdout", ""))
        sys.stderr.write(result.get("stderr", result.get("error", "")))
        if result.get("error") and not result.get("stderr"):
            sys.stderr.write("\n")
        return int(result.get("returncode", 0 if result.get("ok") else 1))
    return subprocess.call([REAL_GIT, *args])


if __name__ == "__main__":
    raise SystemExit(main())
