#!/usr/bin/env python3
from __future__ import annotations

import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "scm_broker"))
from client import request

ALLOWED = {
    ("pr", "create"),
    ("pr", "view"),
    ("pr", "status"),
    ("pr", "checks"),
}


def main() -> int:
    args = sys.argv[1:]
    if len(args) < 2 or tuple(args[:2]) not in ALLOWED:
        print("agent-harness: this gh operation is not exposed to the agent", file=sys.stderr)
        return 126
    result = request({"kind": "gh", "args": args, "cwd": os.getcwd()})
    sys.stdout.write(result.get("stdout", ""))
    sys.stderr.write(result.get("stderr", result.get("error", "")))
    if result.get("error") and not result.get("stderr"):
        sys.stderr.write("\n")
    return int(result.get("returncode", 0 if result.get("ok") else 1))


if __name__ == "__main__":
    raise SystemExit(main())
